@model IEnumerable<WebsiteBanHang.Models.Category>

@{
    ViewData["Title"] = "Danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h2 class="text-primary-gradient fw-bold">Danh mục</h2>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary-custom btn-sm btn-back-product">
                <i class="bi bi-box"></i> Trở về sản phẩm
            </a>
        </div>
        <a asp-action="Add" class="btn btn-primary-custom fw-semibold btn-add-new-category">
            <i class="bi bi-plus-circle"></i> Thêm danh mục mới
        </a>
    </div>

    <div class="card shadow rounded-4 border-0 category-index-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-header-custom text-primary-custom fw-semibold">
                    <tr>
                        <th>Tên</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <div class="btn-group float-end" role="group">
                                    <a asp-action="Display" asp-route-id="@item.Id" class="btn btn-info-custom btn-sm">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning-custom btn-sm">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger-custom btn-sm">
                                        <i class="bi bi-trash"></i> Xoá
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8faff; /* Consistent light blue background */
    }

    .text-primary-gradient {
        background: linear-gradient(45deg, #007bff, #6a00ff); /* Blue to purple gradient for title */
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2.5rem; /* Larger font size for prominence */
        font-weight: 800;
        text-shadow: 0 4px 10px rgba(0, 123, 255, 0.2);
    }

    /* Card styling */
    .category-index-card {
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgba(0, 123, 255, 0.15) !important; /* Lighter blue shadow */
        border: 1px solid #cce0ff !important; /* Light blue border */
    }

    /* Table styling */
    .custom-table {
        width: 100%;
        border-collapse: separate !important;
        border-spacing: 0 10px; /* Reduced spacing */
        background: #fff;
        border-radius: 1rem; /* Consistent border radius */
    }

    /* Table Header */
    .table-header-custom {
        background: linear-gradient(90deg, #e0efff, #d5e9ff); /* Light blue gradient for table header */
        color: #0056b3 !important; /* Darker blue text */
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 1rem 1rem 0 0 !important; /* Rounded top corners */
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.1);
    }

    .custom-table thead th {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        font-size: 1rem;
        border-right: 1px solid #cce0ff; /* Light blue border between headers */
    }

        .custom-table thead th:last-child {
            border-right: none;
            text-align: center;
        }

    /* Table Body Rows */
    .custom-table tbody tr {
        background: #ffffff; /* White background for rows */
        border-radius: 0.75rem; /* Rounded corners for rows */
        box-shadow: 0 2px 8px rgba(0, 123, 255, 0.08); /* Subtle blue shadow */
        transition: all 0.3s ease;
        font-size: 0.95rem;
        color: #343a40; /* Dark gray text */
        margin-bottom: 0.5rem; /* Space between rows */
    }

        .custom-table tbody tr:hover {
            background: #e9f5ff; /* Very light blue on hover */
            box-shadow: 0 6px 20px rgba(0, 123, 255, 0.2); /* Enhanced blue shadow on hover */
            transform: translateY(-3px); /* Slight lift effect */
        }

    /* Table Cells */
    .custom-table td {
        padding: 0.85rem 1.5rem;
        vertical-align: middle;
        border-right: 1px solid #e0efff; /* Lighter blue border between cells */
        font-weight: 500;
    }

        .custom-table td:last-child {
            border-right: none;
            text-align: center;
        }

    /* === Buttons === */

    /* Generic button styling for consistent look */
    .btn-group .btn,
    .btn-outline-primary-custom,
    .btn-primary-custom {
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
    }

        .btn-group .btn i,
        .btn-outline-primary-custom i,
        .btn-primary-custom i {
            font-size: 1rem;
        }

    /* "Trở về sản phẩm" button */
    .btn-back-product {
        border-color: #007bff; /* Primary blue border */
        color: #007bff; /* Primary blue text */
        background-color: transparent;
        box-shadow: 0 2px 8px rgba(0, 123, 255, 0.1);
    }

        .btn-back-product:hover {
            background-color: #e0efff; /* Very light blue background */
            color: #0056b3;
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.2);
            transform: translateY(-1px);
        }

    /* "Thêm danh mục mới" button */
    .btn-add-new-category {
        background-color: #007bff; /* Primary blue */
        border-color: #007bff;
        color: white;
        font-size: 1.05rem;
        padding: 0.6rem 1.5rem;
        box-shadow: 0 5px 15px rgba(0, 123, 255, 0.3);
    }

        .btn-add-new-category:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            box-shadow: 0 8px 20px rgba(0, 123, 255, 0.5);
            transform: translateY(-2px);
        }

    /* Action buttons in table */
    .btn-info-custom {
        background-color: #17a2b8; /* Bootstrap Info Blue for "Xem" */
        border-color: #17a2b8;
        color: white;
        box-shadow: 0 2px 8px rgba(23, 162, 184, 0.2);
    }

        .btn-info-custom:hover {
            background-color: #138496;
            border-color: #117a8b;
            box-shadow: 0 4px 12px rgba(23, 162, 184, 0.4);
            transform: translateY(-1px);
        }

    .btn-warning-custom {
        background-color: #ffc107; /* Bootstrap Warning Yellow for "Sửa" */
        border-color: #ffc107;
        color: #343a40; /* Dark text for contrast */
        box-shadow: 0 2px 8px rgba(255, 193, 7, 0.2);
    }

        .btn-warning-custom:hover {
            background-color: #e0a800;
            border-color: #d39e00;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.4);
            transform: translateY(-1px);
        }

    .btn-danger-custom {
        background-color: #dc3545; /* Bootstrap Danger Red for "Xoá" */
        border-color: #dc3545;
        color: white;
        box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2);
    }

        .btn-danger-custom:hover {
            background-color: #c82333;
            border-color: #bd2130;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
            transform: translateY(-1px);
        }
</style>