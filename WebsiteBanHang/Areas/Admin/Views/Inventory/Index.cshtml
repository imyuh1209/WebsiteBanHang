@{
}

@model IEnumerable<WebsiteBanHang.Models.Product>
<h2>Quản lý kho hàng</h2>
<table class="table">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th>Tồn kho</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Stock</td>
                <td>
                    <form asp-action="UpdateStock" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@product.Id" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
