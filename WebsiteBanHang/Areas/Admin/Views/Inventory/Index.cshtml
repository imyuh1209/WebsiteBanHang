@model IEnumerable<WebsiteBanHang.Models.Product>

<h2 class="mt-3 mb-4">Quản lý kho hàng</h2>

<table class="table table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Tên sản phẩm</th>
            <th>Tồn kho hiện tại</th>
            <th>Cập nhật tồn kho</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Stock</td>
                <td>
                    <form asp-action="UpdateStock" method="post" class="d-inline form-inline">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="number" name="newStock" value="@product.Stock" class="form-control d-inline w-50" />
                        <button type="submit" class="btn btn-sm btn-primary ml-2">Cập nhật</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
