@model WebsiteBanHang.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2>Chi tiết đơn hàng #@Model.Id</h2>
<p><strong>Khách hàng:</strong> @Model.CustomerFullName</p>
<p><strong>Email:</strong> @Model.CustomerEmail</p>
<p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
<p><strong>Trạng thái:</strong> @Model.Status</p>
<p><strong>Tổng tiền:</strong> @Model.GrandTotal.ToString("c", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</p>

<h4>Sản phẩm trong đơn</h4>
<table class="table">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.Total.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<form asp-action="UpdateStatus" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <label for="status">Cập nhật trạng thái:</label>
        <select name="status" class="form-control" style="width:200px;display:inline-block;">
            <option value="Chờ xử lý" selected="@("Chờ xử lý" == Model.Status)">Chờ xử lý</option>
            <option value="Đang giao" selected="@("Đang giao" == Model.Status)">Đang giao</option>
            <option value="Hoàn thành" selected="@("Hoàn thành" == Model.Status)">Hoàn thành</option>
            <option value="Đã huỷ" selected="@("Đã huỷ" == Model.Status)">Đã huỷ</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm ms-2">Cập nhật</button>
    </div>
</form>
<a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>
