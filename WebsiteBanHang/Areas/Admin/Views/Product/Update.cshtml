@model WebsiteBanHang.Models.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-4 border-0 update-product-card">
        <div class="card-header bg-primary-gradient text-white rounded-top-4 shadow-sm d-flex align-items-center justify-content-center py-3">
            <h2 class="mb-0 fw-bold">Cập nhật sản phẩm</h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="row g-4">
                    <div class="col-md-8">
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control form-control-custom" />
                            <span asp-validation-for="Name" class="text-danger-custom"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Price" class="form-label">Giá</label>
                            <input asp-for="Price" class="form-control form-control-custom" />
                            <span asp-validation-for="Price" class="text-danger-custom"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control form-control-custom" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger-custom"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CategoryId" class="form-label">Danh mục</label>
                            <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-control form-control-custom"></select>
                            <span asp-validation-for="CategoryId" class="text-danger-custom"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ImageUrl" class="form-label">Ảnh sản phẩm</label>
                            <input type="file" asp-for="ImageUrl" class="form-control form-control-custom" id="imageInput" />
                            <span asp-validation-for="ImageUrl" class="text-danger-custom"></span>
                        </div>

                        <div class="d-flex justify-content-start gap-3 mt-4">
                            <button type="submit" class="btn btn-primary-custom px-4 fw-semibold" style="min-width:120px;">Cập nhật</button>
                            <a asp-action="Index" class="btn btn-secondary-custom px-4 fw-semibold" style="min-width:120px;">Huỷ</a>
                        </div>
                    </div>

                    <div class="col-md-4 text-center d-flex flex-column align-items-center">
                        <label class="form-label d-block text-primary-gradient-text fw-bold mb-3">Xem trước ảnh</label>
                        <div class="image-preview-container">
                            <img src="@Model.ImageUrl" alt="Product Image" id="previewImage"
                                 class="img-thumbnail preview-image-custom" />
                            @if (string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="no-image-overlay" id="noImageOverlay">
                                    <i class="bi bi-image text-primary-light" style="font-size: 3rem;"></i>
                                    <p class="text-muted-custom mt-2 mb-0">Chưa có ảnh</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8faff; /* Consistent light blue background */
        color: #343a40; /* Default text color */
    }

    /* Main Card Styling */
    .update-product-card {
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgba(0, 123, 255, 0.15) !important; /* Lighter blue shadow */
        border: 1px solid #cce0ff !important; /* Light blue border */
    }

    /* Card Header */
    .bg-primary-gradient {
        background: linear-gradient(45deg, #007bff, #6a00ff) !important; /* Blue to purple gradient for header */
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
    }

    /* Form Labels */
    .form-label {
        font-weight: 600;
        color: #0056b3; /* Darker blue for labels */
        font-size: 1.05rem;
    }

    /* Form Controls (Input, Textarea, Select) */
    .form-control-custom {
        border: 1.8px solid #a7d9f7; /* Light blue border */
        border-radius: 0.5rem;
        padding: 0.6rem 0.9rem;
        font-size: 1rem;
        color: #343a40; /* Dark text */
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control-custom:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25); /* Bootstrap-like focus ring */
            outline: none;
        }

    /* Validation Error Text */
    .text-danger-custom {
        color: #dc3545 !important; /* Bootstrap Danger Red */
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Buttons */
    .btn {
        font-weight: 600;
        padding: 0.55rem 1.3rem;
        border-radius: 0.5rem;
        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        transition: background-color 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
    }

    /* Primary Button (Update) */
    .btn-primary-custom {
        background-color: #007bff; /* Primary blue */
        border-color: #007bff;
        color: #fff;
    }

        .btn-primary-custom:hover {
            background-color: #0056b3;
            border-color: #004085;
            box-shadow: 0 7px 18px rgba(0, 123, 255, 0.4);
            color: #fff;
        }

    /* Secondary Button (Cancel) */
    .btn-secondary-custom {
        background-color: #6c757d; /* Standard secondary gray */
        border-color: #6c757d;
        color: #fff;
    }

        .btn-secondary-custom:hover {
            background-color: #5a6268;
            border-color: #545b62;
            box-shadow: 0 7px 18px rgba(108, 117, 125, 0.4);
            color: #fff;
        }

    /* Preview Image Label */
    .text-primary-gradient-text {
        background: linear-gradient(45deg, #007bff, #6a00ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.2rem;
        user-select: none;
    }

    /* Image Preview Container */
    .image-preview-container {
        position: relative;
        width: 100%;
        max-width: 250px; /* Adjust as needed */
        height: 250px; /* Keep consistent height for placeholder */
        border-radius: 1rem;
        overflow: hidden;
        border: 2px dashed #a7d9f7; /* Light blue dashed border */
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e0efff; /* Very light blue background */
        box-shadow: 0 6px 16px rgba(0, 123, 255, 0.2); /* Light blue shadow */
        transition: box-shadow 0.3s ease, border-color 0.3s ease;
    }

        .image-preview-container:hover {
            box-shadow: 0 10px 28px rgba(0, 123, 255, 0.4);
            border-color: #007bff;
        }

    /* Preview Image */
    .preview-image-custom {
        max-width: 100%;
        max-height: 100%; /* Ensure image fits container */
        width: auto;
        height: auto;
        display: block;
        border: none; /* Remove default img-thumbnail border */
        border-radius: 0; /* No radius on image itself as container handles it */
        object-fit: contain; /* Ensure entire image is visible */
    }

    /* No Image Overlay */
    .no-image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: rgba(224, 239, 255, 0.9); /* Semi-transparent light blue */
        border-radius: 1rem;
        z-index: 1; /* Ensure it's on top of a potentially broken image */
    }

    .text-primary-light {
        color: #8bbef8 !important; /* Lighter blue for placeholder icon */
    }

    .text-muted-custom {
        color: #6c757d !important; /* Standard muted text */
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('imageInput');
            const previewImage = document.getElementById('previewImage');
            const noImageOverlay = document.getElementById('noImageOverlay');

            // Function to update image preview
            function updateImagePreview(file) {
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImage.src = e.target.result;
                        previewImage.style.display = 'block'; // Show image
                        if (noImageOverlay) {
                            noImageOverlay.style.display = 'none'; // Hide overlay
                        }
                    };
                    reader.readAsDataURL(file);
                } else {
                    // No file selected or cleared
                    previewImage.src = ""; // Clear image src
                    previewImage.style.display = 'none'; // Hide image
                    if (noImageOverlay) {
                        noImageOverlay.style.display = 'flex'; // Show overlay
                    }
                }
            }

            // Event listener for file input change
            imageInput.addEventListener('change', function (event) {
                const file = event.target.files[0];
                updateImagePreview(file);
            });

            // Initial check for existing image
            if (previewImage.src && previewImage.src !== window.location.href) { // Check if src is valid and not just current URL
                previewImage.style.display = 'block';
                if (noImageOverlay) {
                    noImageOverlay.style.display = 'none';
                }
            } else {
                previewImage.style.display = 'none';
                if (noImageOverlay) {
                    noImageOverlay.style.display = 'flex';
                }
            }
        });
    </script>
}