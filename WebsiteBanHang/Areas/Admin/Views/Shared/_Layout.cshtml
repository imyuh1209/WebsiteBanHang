<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khu vực quản trị</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg" href="~/admin.png" />

    <style>
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .main-content {
            flex: 1 0 auto;
        }

        footer.footer {
            height: 120px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            background-color: #f8f9fa;
            font-size: 0.9rem;
            border-top: 1px solid #dee2e6;
        }

        /* Thêm style cho header menu */
        .navbar-nav .nav-link {
            font-weight: 600;
            color: #4a4a4a;
            transition: color 0.25s ease;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                color: #0d6efd; /* Màu primary của Bootstrap */
            }

        .navbar-brand {
            font-size: 1.4rem;
        }

            .navbar-brand.d-flex.align-items-center {
                /* Icon margin đã bị loại bỏ nên không cần chỉnh */
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold text-primary"
                   asp-area="Admin" asp-controller="Product" asp-action="Index">
                    TRANG QUẢN TRỊ
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarAdmin" aria-controls="navbarAdmin"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarAdmin">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Product") ? "active" : "")"
                               asp-area="Admin" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Categories") ? "active" : "")"
                               asp-area="Admin" asp-controller="Categories" asp-action="Index">Danh mục</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">Quản lý người dùng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Order") ? "active" : "")"
                               asp-area="Admin" asp-controller="Order" asp-action="Index">Đơn hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Inventory" asp-action="Index">Quản lý kho</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics") ? "active" : "")"
                               asp-area="Admin" asp-controller="Statistics" asp-action="Index">Thống kê</a>
                        </li>

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center h-100">
            <div>
                © @DateTime.Now.Year HTShop
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
