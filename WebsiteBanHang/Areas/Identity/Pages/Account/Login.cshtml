@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden login-card">
                <div class="card-header text-white text-center py-4 login-header">
                    <h3 class="mb-0 fw-semibold">@ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <!-- ✅ SỬA chỗ này để giữ returnUrl -->
                    <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control shadow-sm login-input" autocomplete="username" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control shadow-sm login-input" autocomplete="current-password" placeholder="password" />
                            <label asp-for="Input.Password">Mật khẩu</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                            <label class="form-check-label text-muted" asp-for="Input.RememberMe" for="rememberMe">Ghi nhớ đăng nhập</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 shadow-sm login-button">Đăng nhập</button>
                        </div>

                        <div class="text-center mt-4">
                            <p class="mb-2 text-muted">
                                <a href="/Identity/Account/ForgotPassword" class="link-primary fw-medium">Quên mật khẩu?</a>
                            </p>
                            <p class="mb-0 text-muted">
                                Chưa có tài khoản?
                                <a href="/Identity/Account/Register" class="link-primary fw-medium">Đăng ký ngay</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const faceIcon = document.getElementById('faceIcon');
            const passwordInput = document.querySelector('input[type="password"]');

            if (!faceIcon || !passwordInput) return;

            const faceCoverSVG = `
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="48" height="48" role="img" aria-label="Mặt đeo kính đen">
                    <circle cx="32" cy="32" r="30" fill="#a7d9f7" />
                    <rect x="12" y="18" width="14" height="12" rx="3" ry="3" fill="#000" />
                    <rect x="38" y="18" width="14" height="12" rx="3" ry="3" fill="#000" />
                    <rect x="26" y="23" width="12" height="4" fill="#333" />
                    <path d="M20 44c5 6 18 6 24 0" stroke="#0056b3" stroke-width="4" stroke-linecap="round" fill="none"/>
                </svg>
            `;

            const faceSmileSVG = `
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="48" height="48" role="img" aria-label="Mặt cười">
                    <circle cx="32" cy="32" r="30" fill="#a7d9f7" />
                    <circle cx="20" cy="24" r="8" fill="#fff"/>
                    <circle cx="44" cy="24" r="8" fill="#fff"/>
                    <circle cx="20" cy="24" r="4" fill="#007bff"/>
                    <circle cx="44" cy="24" r="4" fill="#007bff"/>
                    <path d="M20 44c5 6 18 6 24 0" stroke="#0056b3" stroke-width="4" stroke-linecap="round" fill="none"/>
                </svg>
            `;

            passwordInput.addEventListener('focus', () => {
                faceIcon.innerHTML = faceCoverSVG;
            });

            passwordInput.addEventListener('blur', () => {
                faceIcon.innerHTML = faceSmileSVG;
            });
        });
    </script>
}

<style>
    body {
        background-color: #f8faff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        box-shadow: 0 1rem 3rem rgba(0, 123, 255, 0.15) !important;
        border: 1px solid #cce0ff !important;
    }

    .login-header {
        background: linear-gradient(135deg, #007bff, #6a00ff);
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
    }

        .login-header h3 {
            font-size: 1.75rem;
            letter-spacing: 0.05em;
        }

    .login-input {
        border-color: #a7d9f7;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .login-input:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
        }

    .form-floating > .form-control::placeholder {
        color: #888;
    }

    .form-floating > label {
        color: #6c757d;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #007bff;
    }

    .form-check-input {
        border-color: #a7d9f7;
    }

        .form-check-input:checked {
            background-color: #007bff;
            border-color: #007bff;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25);
        }

    .form-check-label.text-muted {
        color: #6c757d !important;
    }

    .login-button {
        background-color: #007bff;
        border-color: #007bff;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 123, 255, 0.3);
    }

        .login-button:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 123, 255, 0.5);
        }

    .text-muted {
        color: #6c757d !important;
    }

    .link-primary {
        color: #007bff !important;
        text-decoration: none;
        transition: color 0.2s ease;
    }

        .link-primary:hover {
            color: #0056b3 !important;
            text-decoration: underline;
        }
</style>
