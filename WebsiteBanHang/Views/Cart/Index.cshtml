@model IEnumerable<WebsiteBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    var total = Model?.Sum(i => i.Price * i.Quantity) ?? 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center py-4 px-4">
                    <h2 class="mb-0 fw-bold"><i class="bi bi-cart4 me-2"></i>Giỏ hàng của bạn</h2>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i> Tiếp tục mua sắm
                    </a>
                </div>
                <div class="card-body p-4">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle text-center cart-table mb-0">

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="img-thumbnail" style="width: 70px; height: 70px; object-fit: contain;" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center bg-light border rounded" style="width: 70px; height: 70px;">
                                                        <i class="bi bi-image text-muted fs-2"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@item.ProductName</div>
                                            </td>
                                            <td class="text-primary fw-bold">@item.Price.ToString("C")</td>
                                            <td>
                                                <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center align-items-center gap-2">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm px-2" onclick="decrementQuantity(this)">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="number" name="quantity" class="form-control text-center qty-input" value="@item.Quantity" min="1" max="100" onchange="this.form.submit()" style="width: 55px;" />
                                                    <button type="button" class="btn btn-outline-secondary btn-sm px-2" onclick="incrementQuantity(this)">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </form>
                                            </td>
                                            <td class="fw-bold text-success">@((item.Price * item.Quantity).ToString("C"))</td>
                                            <td>
                                                <form asp-action="RemoveFromCart" method="post">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                                        <i class="bi bi-trash"></i> Xóa
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="row mt-4">
                            <div class="col-md-6 col-lg-4 ms-auto">
                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fs-5 fw-semibold">Tổng tiền:</span>
                                            <span class="fs-4 fw-bold text-primary">@total.ToString("C")</span>
                                        </div>
                                        <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary btn-lg w-100 mt-3 rounded-pill">
                                            <i class="bi bi-credit-card me-2"></i> Thanh toán
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-cart-x" style="font-size: 5rem; color: #a7d9f7;"></i>
                            <h3 class="mt-4 text-secondary">Giỏ hàng của bạn đang trống</h3>
                            <p class="text-muted mb-4">Hãy thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm</p>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                                <i class="bi bi-shop me-2"></i> Tiếp tục mua sắm
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function incrementQuantity(button) {
            const input = button.parentNode.querySelector('input[type="number"]');
            if (parseInt(input.value) < parseInt(input.max)) {
                input.value = parseInt(input.value) + 1;
                input.form.submit();
            }
        }
        function decrementQuantity(button) {
            const input = button.parentNode.querySelector('input[type="number"]');
            if (parseInt(input.value) > parseInt(input.min)) {
                input.value = parseInt(input.value) - 1;
                input.form.submit();
            }
        }
    </script>
}

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #007bff, #6a00ff) !important;
    }

    .cart-table th, .cart-table td {
        vertical-align: middle !important;
    }

    .cart-table th {
        font-size: 1rem;
        font-weight: 600;
        color: #0056b3;
        background: #eaf4fd;
        border-bottom: 2px solid #a7d9f7;
    }

    .cart-table td {
        font-size: 1.05rem;
    }

    .qty-input::-webkit-inner-spin-button,
    .qty-input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .qty-input {
        -moz-appearance: textfield;
    }
</style>