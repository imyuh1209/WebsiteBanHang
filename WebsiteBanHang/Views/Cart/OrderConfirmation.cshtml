@{
    ViewData["Title"] = "Xác nhận đơn hàng";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg p-5">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        <h2 class="mt-4 text-success fw-bold">Cảm ơn bạn!</h2>
        <h3 class="mb-4">Đơn hàng của bạn đã được đặt thành công.</h3>

        <hr />
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg mt-3">
            <i class="bi bi-house-door me-2"></i> Quay lại trang chủ
        </a>
    </div>
</div>

<style>
    body {
        background-color: #f8faff;
        color: #343a40;
    }

    .card {
        border-radius: 1rem;
        border: none;
        background-color: #fff;
    }

    .text-success {
        color: #28a745 !important;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
        }
</style>