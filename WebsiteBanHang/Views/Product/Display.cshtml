@model WebsiteBanHang.Models.Product

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card product-card-custom rounded-4 overflow-hidden">
        <div class="card-header product-header-custom d-flex justify-content-between align-items-center py-3 px-4">
            <h2 class="mb-0 text-white fw-bold">@Model.Name</h2>
            <a asp-controller="Product" asp-action="Index" asp-area="" class="btn btn-outline-light btn-back-custom">
                Trở về danh sách
            </a>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <div class="price-tag-custom mb-4">
                        <h3 class="fw-bold mb-0">
                            @Model.Price.ToString("C")
                        </h3>
                    </div>
                    <p class="mb-2"><strong>Kho:</strong> @Model.Stock</p>
                    <div class="description-section-custom mb-4">
                        <h5 class="mb-2 fw-semibold text-primary-dark">Mô tả sản phẩm</h5>
                        <div class="card bg-light-blue border-0 shadow-sm rounded-4">
                            <div class="card-body fs-6 text-muted-custom">
                                @Model.Description
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CPU) ||
                                        !string.IsNullOrEmpty(Model.RAM) ||
                                        !string.IsNullOrEmpty(Model.Storage) ||
                                        !string.IsNullOrEmpty(Model.GPU) ||
                                        !string.IsNullOrEmpty(Model.OperatingSystem) ||
                                        !string.IsNullOrEmpty(Model.ScreenSize))
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white fw-bold">
                                Thông số kỹ thuật
                            </div>
                            <ul class="list-group list-group-flush">
                                @if (!string.IsNullOrEmpty(Model.CPU))
                                {
                                    <li class="list-group-item"><strong>CPU:</strong> @Model.CPU</li>
                                }
                                @if (!string.IsNullOrEmpty(Model.RAM))
                                {
                                    <li class="list-group-item"><strong>RAM:</strong> @Model.RAM</li>
                                }
                                @if (!string.IsNullOrEmpty(Model.Storage))
                                {
                                    <li class="list-group-item"><strong>Ổ cứng:</strong> @Model.Storage</li>
                                }
                                @if (!string.IsNullOrEmpty(Model.GPU))
                                {
                                    <li class="list-group-item"><strong>Card đồ họa:</strong> @Model.GPU</li>
                                }
                                @if (!string.IsNullOrEmpty(Model.OperatingSystem))
                                {
                                    <li class="list-group-item"><strong>Hệ điều hành:</strong> @Model.OperatingSystem</li>
                                }
                                @if (!string.IsNullOrEmpty(Model.ScreenSize))
                                {
                                    <li class="list-group-item"><strong>Kích thước màn hình:</strong> @Model.ScreenSize</li>
                                }
                            </ul>
                        </div>
                    }
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="d-flex align-items-center">
                            <div class="input-group me-3" style="width: 140px;">
                                <span class="input-group-text bg-light-blue-input">Số lượng</span>
                                <input type="number" name="quantity" class="form-control form-control-custom-qty" value="1" min="1" max="100" />
                            </div>
                            <button type="submit" class="btn btn-primary-custom btn-sm me-2">
                                Mua ngay
                            </button>
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                Thêm vào giỏ hàng
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-md-6 text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="product-image-container-custom shadow-lg rounded-4 overflow-hidden mx-auto">
                            <img src="@Model.ImageUrl"
                                 alt="Product Image"
                                 class="img-fluid"
                                 style="max-width: 100%; max-height: 400px; object-fit: contain;" />
                        </div>
                    }
                    else
                    {
                        <div class="no-image-placeholder-custom p-5 rounded-4 border border-info-subtle">
                            <p class="text-info-secondary mt-3 fs-5 fw-medium">Chưa có ảnh</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8faff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #343a40;
    }

    .product-card-custom {
        border-radius: 1.25rem;
        border: 1px solid #e3e8f0;
        background: #fff;
        box-shadow: 0 8px 32px rgba(0, 123, 255, 0.10);
    }

    .product-header-custom {
        background: linear-gradient(45deg, #007bff, #6a00ff);
        border-radius: 1.25rem 1.25rem 0 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .btn-back-custom {
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.45rem 1.1rem;
        border-radius: 1.5rem;
        border-width: 2px;
        color: #fff;
        border-color: #fff !important;
        transition: 0.3s;
    }

        .btn-back-custom:hover {
            background-color: #0056b3 !important;
            box-shadow: 0 6px 20px rgba(0, 86, 179, 0.25);
        }

    .price-tag-custom {
        background: linear-gradient(135deg, #e3f0ff, #b6d0ff);
        padding: 16px 22px;
        border-radius: 1rem;
        color: #004085;
        box-shadow: 0 4px 16px rgba(107, 185, 240, 0.18);
        font-size: 1.5rem;
        display: inline-block;
    }

    .text-primary-dark {
        color: #0056b3;
    }

    .description-section-custom .card {
        background: #f4f8fd;
        border: 1px solid #e3e8f0;
        color: #4a4a4a;
        font-weight: 500;
        line-height: 1.6;
    }

    .text-muted-custom {
        color: #5a6268;
    }

    .bg-light-blue-input {
        background-color: #f4f8fd;
        border-color: #e3e8f0;
        color: #336699;
    }

    .form-control-custom-qty {
        border-color: #e3e8f0;
        color: #343a40;
        transition: 0.3s;
    }

        .form-control-custom-qty:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.15rem rgba(0, 123, 255, 0.15);
        }

    .btn-primary-custom {
        background-color: #007bff !important;
        border-color: #007bff !important;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px rgba(0, 123, 255, 0.15);
        transition: 0.2s;
    }

        .btn-primary-custom:hover {
            background-color: #0056b3 !important;
            border-color: #0056b3 !important;
            box-shadow: 0 6px 18px rgba(0, 123, 255, 0.25);
            transform: translateY(-1px);
        }

    .product-image-container-custom {
        max-width: 380px;
        margin: auto;
        border-radius: 1.25rem;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e3e8f0;
        box-shadow: 0 6px 24px rgba(0, 123, 255, 0.10);
        transition: 0.3s;
    }

        .product-image-container-custom:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 32px rgba(0, 123, 255, 0.18);
        }

    .no-image-placeholder-custom {
        background: #f0f7ff;
        border: 2px dashed #b6d0ff !important;
        color: #007bff;
        transition: 0.2s;
    }

        .no-image-placeholder-custom:hover {
            background-color: #e3f0ff;
            border-color: #0056b3 !important;
            color: #004085;
        }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border-color: #c3e6cb;
        border-radius: 0.75rem;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.12);
    }
</style>