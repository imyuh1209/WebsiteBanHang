@model IEnumerable<WebsiteBanHang.Models.Product>

<div class="container mt-5">
    <div class="product-grid">
        @foreach (var product in Model)
        {
            <div class="product-card rounded-4 shadow-lg border border-primary">
                <div class="image-container rounded-top-4 overflow-hidden">
                    <a href="@Url.Action("Display", "Product", new { id = product.Id })">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="product-grid-thumbnail" />
                        }
                        else
                        {
                            <div class="no-image-placeholder-grid">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </a>
                </div>
                <div class="details-container p-3">
                    <h5 class="product-name fw-semibold mb-2">
                        <a href="@Url.Action("Display", "Product", new { id = product.Id })" class="text-decoration-none text-dark">
                            @product.Name
                        </a>
                    </h5>
                    <p class="price text-primary fw-bold mb-2">@product.Price.ToString("C")</p>
                    <p class="category text-muted mb-3">
                        @* Adjusted margin-bottom for the new button *@
                        <i class="bi bi-tags me-1"></i> @product.Category?.Name
                    </p>
                    @* Add the "Add to Cart" button here *@
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="quantity" value="1" /> @* Default quantity to 1 *@
                        <button type="submit" class="btn btn-primary-custom-grid w-100">
                            <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Base font */
    body, .container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f8faff; /* Light blue background */
        color: #2a3d52; /* Darker blue text for contrast */
    }

    .container {
        max-width: 1200px; /* Adjust container width */
    }

    /* Section title - Adjusted to blue/purple gradient */
    .section-title {
        font-size: 3rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 4px;
        border-left: 8px solid #007bff; /* Bootstrap primary blue */
        padding-left: 20px;
        user-select: none;
        color: #007bff; /* Bootstrap primary blue */
        text-shadow: 0 1px 4px rgba(0, 123, 255, 0.7);
        margin-bottom: 2.5rem; /* Increased margin below title */
    }

    /* Product Grid Layout */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Responsive grid with minimum width */
        gap: 2rem;
        padding-bottom: 2rem;
    }

    /* Individual Product Card */
    .product-card {
        background-color: #fff;
        border-color: #cce0ff !important; /* Light blue border */
        box-shadow: 0 0.5rem 1.5rem rgba(0, 123, 255, 0.1); /* Lighter shadow */
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 123, 255, 0.2); /* Enhanced shadow on hover */
        }

    /* Image Container */
    .image-container {
        height: 200px; /* Fixed height for image container */
        overflow: hidden;
    }

    /* Product Thumbnail in Grid */
    .product-grid-thumbnail {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease-in-out;
    }

    .image-container:hover .product-grid-thumbnail {
        transform: scale(1.05); /* Slightly zoom in on hover */
    }

    /* No Image Placeholder in Grid */
    .no-image-placeholder-grid {
        width: 100%;
        height: 200px;
        background-color: #e0efff; /* Very light blue background */
        border: 3px dashed #a7d9f7; /* Light blue dashed border */
        display: flex;
        align-items: center;
        justify-content: center;
        color: #007bff; /* Bootstrap primary blue for icon */
        font-size: 3rem;
        transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
    }

        .no-image-placeholder-grid:hover {
            background-color: #cce0ff; /* Darker light blue on hover */
            border-color: #0056b3; /* Darker primary blue on hover */
            color: #004085; /* Darker blue for icon on hover */
        }

    /* Details Container */
    .details-container {
        padding: 1.25rem;
    }

    /* Product Name */
    .product-name {
        font-size: 1.1rem;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

        .product-name a:hover {
            color: #0056b3 !important; /* Darker blue on text hover */
        }

    /* Price */
    .price {
        font-size: 1.2rem;
        color: #007bff !important; /* Ensure primary blue color */
    }

    /* Category */
    .category {
        font-size: 0.9rem;
        color: #6c757d !important; /* Bootstrap muted gray */
    }

        .category .bi {
            color: #8bbef8; /* Lighter blue for category icon */
        }

    /* New "Add to Cart" button style */
    .btn-primary-custom-grid {
        background-color: #28a745; /* Bootstrap Success Green */
        border-color: #28a745;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.25rem;
        border-radius: 0.75rem; /* Rounded corners */
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
        display: flex; /* Use flexbox for icon and text alignment */
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

        .btn-primary-custom-grid:hover {
            background-color: #218838; /* Darker green on hover */
            border-color: #1e7e34;
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.5);
            transform: translateY(-2px);
        }

        .btn-primary-custom-grid .bi {
            font-size: 1.1rem; /* Slightly larger icon for the button */
        }
</style>