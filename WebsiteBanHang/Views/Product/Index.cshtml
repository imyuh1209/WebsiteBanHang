@model IEnumerable<WebsiteBanHang.Models.Product>

<div class="container mt-5">
    <div class="product-grid">
        @foreach (var product in Model)
        {
            <div class="product-card rounded-4 shadow-lg border border-primary">
                <div class="image-container rounded-top-4 overflow-hidden">
                    <a href="@Url.Action("Display", "Product", new { id = product.Id })">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="product-grid-thumbnail" />
                        }
                        else
                        {
                            <div class="no-image-placeholder-grid">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </a>
                </div>
                <div class="details-container p-3">
                    <h5 class="product-name fw-semibold mb-2">
                        <a href="@Url.Action("Display", "Product", new { id = product.Id })" class="text-decoration-none text-dark">
                            @product.Name
                        </a>
                    </h5>
                    <p class="price text-primary fw-bold mb-2">@product.Price.ToString("C")</p>
                    <p class="category text-muted mb-3">
                        @* Adjusted margin-bottom for the new button *@
                        <i class="bi bi-tags me-1"></i> @product.Category?.Name
                    </p>
                    @* Add the "Add to Cart" button here *@
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="quantity" value="1" /> @* Default quantity to 1 *@
                        <button type="submit" class="btn btn-primary-custom-grid w-100">
                            <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f8faff;
        color: #2a3d52;
    }

    .container {
        max-width: 1200px;
    }

    /* Product Grid */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        padding: 2rem 0;
    }

    /* Card */
    .product-card {
        background: #fff;
        border: 1px solid #cce0ff;
        border-radius: 1rem;
        box-shadow: 0 6px 18px rgba(0, 123, 255, 0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 123, 255, 0.2);
        }

    /* Image Container */
    .image-container {
        height: 200px;
        overflow: hidden;
        border-radius: 1rem 1rem 0 0;
        background: #fff;
    }

    .product-grid-thumbnail {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        padding: 8px;
        transition: transform 0.4s;
        background: #fff;
    }

    .image-container:hover .product-grid-thumbnail {
        transform: scale(1.05);
    }

    /* No Image Placeholder */
    .no-image-placeholder-grid {
        width: 100%;
        height: 200px;
        background: #e0efff;
        border: 3px dashed #a7d9f7;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #007bff;
        font-size: 2.5rem;
        transition: 0.3s;
    }

        .no-image-placeholder-grid:hover {
            background: #cce0ff;
            border-color: #0056b3;
            color: #004085;
        }

    /* Product Info */
    .details-container {
        padding: 1.25rem;
    }

    .product-name {
        font-size: 1.1rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.5rem;
    }

        .product-name a {
            color: #2a3d52;
            text-decoration: none;
            transition: color 0.2s;
        }

            .product-name a:hover {
                color: #0056b3;
            }

    .price {
        font-size: 1.2rem;
        color: #007bff;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .category {
        font-size: 0.9rem;
        color: #6c757d;
        margin-bottom: 1rem;
    }

        .category .bi {
            color: #8bbef8;
        }

    /* Add to Cart Button */
    .btn-primary-custom-grid {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: #28a745;
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.25rem;
        border-radius: 0.75rem;
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        font-size: 1rem;
        transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
    }

        .btn-primary-custom-grid:hover {
            background: #218838;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
        }

        .btn-primary-custom-grid .bi {
            margin-right: 0.5rem;
            font-size: 1.2rem;
        }
</style>